set_global_assignment -name TOP_LEVEL_ENTITY Controlo_Acessos
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1
set_global_assignment -name PROJECT_CREATION_TIME_DATE "16:00:00 OCTOBER 16, 2026"

set_global_assignment -name VHDL_FILE Identifica_Departamento.vhd
set_global_assignment -name VHDL_FILE Verifica.vhd
set_global_assignment -name VHDL_FILE Controlo_Acessos.vhd

set_location_assignment PIN_C12 -to A[3]
set_location_assignment PIN_D12 -to A[2]
set_location_assignment PIN_C11 -to A[1]
set_location_assignment PIN_C10 -to A[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to A[0]

set_location_assignment PIN_B12 -to S[1]
set_location_assignment PIN_A12 -to S[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to S[0]

set_location_assignment PIN_A8 -to R
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to R